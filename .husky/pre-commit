#!/usr/bin/env sh

echo "🔍 开始代码质量检查..."

if pnpm lint:prettier; then
  echo "✅ Prettier 检查通过"
else
  echo "❌ Prettier 检查失败，请运行: pnpm lint:prettier:fix"
  exit 1
fi

if pnpm lint:eslint; then
  echo "✅ ESLint 检查通过"
else
  echo "❌ ESLint 检查失败，请运行: pnpm lint:eslint:fix"
  exit 1
fi

if pnpm lint:stylelint; then
  echo "✅ StyleLint 检查通过"
else
  echo "❌ StyleLint 检查失败，请运行: pnpm lint:stylelint:fix"
  exit 1
fi

if pnpm lint:spellcheck; then
  echo "✅ 拼写检查通过"
  echo "🎉 所有检查通过！"
else
  echo "❌ 拼写检查失败"
  exit 1
fi