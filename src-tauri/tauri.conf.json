{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tera-shell",
  "version": "1.0.0",
  "identifier": "com.terashell.app",
	"bundle": {
		"active": true,
		"targets": ["nsis","msi"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tera Shell",
        "width": 1200,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 800,
        "decorations": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#f5f5f5",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
