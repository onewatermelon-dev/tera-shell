{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions for terminal commands, dialogs, storage, and opening Ctrl-clicked web URLs",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "shell:allow-open",
    "opener:allow-open-url",
    "dialog:default",
    "store:default"
  ]
}
